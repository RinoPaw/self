{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RinoPaw/self/literature/records/schema.json",
  "title": "self literature record",
  "type": "object",
  "required": ["title", "authors", "status", "sources", "project_relation"],
  "properties": {
    "title": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "year": {"type": ["integer", "null"]},
    "doi": {"type": ["string", "null"]},
    "venue": {"type": ["string", "null"]},
    "type": {"type": ["string", "null"]},
    "ids": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "urls": {
      "type": "object",
      "properties": {
        "landing": {"type": ["string", "null"]},
        "open_access": {"type": ["string", "null"]},
        "full_text": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["candidate", "metadata-checked", "abstract-read", "fulltext-read", "core", "rejected"]},
    "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "project_relation": {"type": "string"},
    "quality_evidence": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"type": "string"}},
    "objections": {"type": "array", "items": {"type": "string"}},
    "notes_file": {"type": ["string", "null"]},
    "checked_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
